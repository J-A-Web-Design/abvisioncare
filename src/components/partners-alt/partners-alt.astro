---
import Container from "../utility/container.astro";
import { Picture } from "astro:assets";

interface Partner {
  link: string;
  image: string;
  alt: string;
}

interface Props {
  title: string;
  partners: Partner[];
  subheading: {
    markdown_content: string;
    color: string;
  };
}
const block = Astro.props;

const { title, partners, subheading } = Astro.props;
---

<section class="bg-color">
    <Container>
      <div class="py-8 lg:py-16 mx-auto max-w-screen-xl px-4">
        <h2 class="mb-8 lg:mb-16 text-3xl font-extrabold tracking-tight leading-tight text-center text-gray-900 md:text-4xl">{title}</h2>
        <p class="cs-text" style={`color: ${block.subheading.color};`}>
          {block.subheading.markdown_content}
       </p>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 text-gray-500 sm:gap-12 lg:grid-cols-3 dark:text-gray-400 justify-items-center items-center">
          {partners.map(partner => (
            <a href={partner.link} class="flex justify-center items-center" target="_blank">
              <Picture
                class="w-36 hover:text-gray-900 dark:hover:text-white rounded"
                src={partner.image}
                alt={partner.alt}
                width={150} 
                height={70} 
              />
            </a>
          ))}
        </div>
        </div>
    </Container>
</section>
<style>
  .bg-color{
    background: #fff;
  }
  .cs-text {
          /* 16px - 20px */
          font-size: clamp(1rem, 1.95vw, 1.25rem);
          line-height: 1.5em;
          text-align: left;
          width: 100%;
          /* 464px - 622px */
          max-width: 80rem;
          margin: 0 auto 0 0;
          /* 40px - 48px */
          margin-bottom: clamp(2.5rem, 4vw, 3rem);
          color: #fff;
      }
</style>