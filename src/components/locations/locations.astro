---
const { locations } = Astro.props;
---


<div class="sm:flex flex-row justify-center">
    <div class="m-8">
      <iframe
        src="https://www.google.com/maps/d/embed?mid=1Rhxpvbfsh0ZWprSjaMlTOi3zsbpH0zQ&ehbc=2E312F"
        width="700"
        height="980" class="rounded"></iframe>
    </div>
    <div class="grid lg:grid-cols-2 gap-4 my-8 mx-4 sm:mx-2">
      {
         locations.map((location) => (
          <section class="location-card">
            <h3 class="location-name">
              {location.name}
            </h3>

            <div class="location-detail">
              <svg class="location-icon" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="none" viewBox="0 0 24 24">
                <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M12 21c-4-4-7-7.5-7-11a7 7 0 1 1 14 0c0 3.5-3 7-7 11Z"/>
                <circle cx="12" cy="10" r="2.5" stroke="currentColor" stroke-width="1.8"/>
              </svg>
              <span>{location.address}</span>
            </div>

            <div class="location-detail">
              <svg class="location-icon" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" width="20" height="20" fill="none" viewBox="0 0 24 24">
                <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.8" d="M5 4h3l2 5-2.5 1.5a11 11 0 0 0 5 5L14 13l5 2v3a2 2 0 0 1-2 2A15 15 0 0 1 3 6a2 2 0 0 1 2-2Z"/>
              </svg>
              <a href={location.numberLink} class="location-link">{location.number}</a>
              {location.ext && <span class="location-ext">ext. {location.ext}</span>}
            </div>

            {location.mapLink && (
              <a
                href={location.mapLink}
                class="location-map-link">
                View Map
                <svg
                  aria-hidden="true"
                  xmlns="http://www.w3.org/2000/svg"
                  width="18"
                  height="18"
                  fill="none"
                  viewBox="0 0 24 24">
                  <path
                    stroke="currentColor"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M19 12H5m14 0-4 4m4-4-4-4"
                  />
                </svg>
              </a>
            )}
          </section>
        ))
      }
    </div>
  </div>

<style>
  .location-card {
    display: block;
    background-color: #ffffff;
    border: 1px solid #e5e7eb;
    border-radius: 0.75rem;
    box-shadow: 0 1px 3px 0 rgba(0, 0, 0, 0.08);
    padding: 1.25rem 1.5rem;
    transition: box-shadow 0.2s ease-in-out, transform 0.2s ease-in-out, border-color 0.2s ease-in-out;
  }

  .location-card:hover {
    box-shadow: 0 8px 20px -4px rgba(0, 0, 0, 0.12);
    border-color: var(--primary);
    transform: translateY(-2px);
  }

  .location-name {
    font-size: 1.125rem;
    font-weight: 700;
    color: var(--headerColor, #1a1a1a);
    margin-bottom: 0.75rem;
  }

  .location-detail {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: #4b5563;
    font-size: 0.9rem;
    margin-bottom: 0.5rem;
  }

  .location-icon {
    flex-shrink: 0;
    color: var(--primary);
  }

  .location-link {
    color: #4b5563;
    text-decoration: none;
  }

  .location-link:hover {
    color: var(--primary);
  }

  .location-ext {
    color: #9ca3af;
    font-size: 0.8rem;
  }

  .location-map-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: 0.5rem;
    font-weight: 600;
    font-size: 0.9rem;
    color: var(--primary);
    text-decoration: none;
  }

  .location-map-link:hover {
    color: var(--headerColor, #1a1a1a);
  }
</style>
