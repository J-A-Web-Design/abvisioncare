---
import Container from "../utility/container.astro";
import { Picture } from "astro:assets";


const { topper, title, partners, plain_title } = Astro.props;
---

<section class="bg-color">
    <Container>
      <div class="py-6 lg:py-10 mx-auto max-w-screen-xl px-4">
        <span class="cs-topper">{topper}</span>
        <h2 class:list={["cs-title", { "cs-title-plain": plain_title }]}>{title}</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 text-gray-500 sm:gap-24 lg:flex dark:text-gray-400 justify-center justify-items-center items-center">
          {partners.map(partner => (
            <a href={partner.link} class="flex justify-center items-center" target="_blank">
              <Picture
                class="w-40 hover:text-gray-900 dark:hover:text-white rounded"
                src={partner.image}
                alt={partner.alt}
                width={150} 
                height={70} 
              />
            </a>
          ))}
        </div>
        </div>
    </Container>
</section>
<style>
  .bg-color{
    background: #f2f2f2;
  }
  .cs-topper {
    text-align: center;
  }
  .cs-title {
    text-align: center;
    margin: 0 auto 2rem auto;
  }
  .cs-title::after {
    margin-left: auto;
    margin-right: auto;
  }
  .cs-title-plain {
    font-weight: 400;
  }
  .cs-title-plain::after {
    display: none;
  }
</style>