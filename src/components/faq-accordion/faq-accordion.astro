---
import Markdown from "../utility/markdown.astro";
import { marked } from 'marked';

interface Props {
  faqs: {
    markdown_content: string;
    color: string;
  };
}

const block = Astro.props;

---

<!-- ============================================ --><!--                     FAQ                      --><!-- ============================================ -->
<section id="faq-1194">
  <div class="cs-container">
    <div class="cs-content">
      <span class="cs-topper">FAQ</span>
      <h2 class="cs-title">Common Questions & Answers about Vision Care in Alberta</h2>
      <Markdown content={block.faqs?.markdown_content || 'Content not available'}>          
    </div>
  </div>
</section>


<style>
  /*-- -------------------------- -->
<---            FAQ             -->
<--- -------------------------- -*/

  /* Mobile - 360px */
  @media only screen and (min-width: 0rem) {
    #faq-1194 {
      padding: var(--sectionPadding);
      position: relative;
      overflow: hidden;
    }
    #faq-1194 .cs-container {
      width: 100%;
      /* chnages to 1280px at desktop */
      max-width: 80rem;
      margin: auto;
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      /* 28px - 36px */
      gap: clamp(1.75rem, 3.5vw, 2.25rem);
    }
    #faq-1194 .cs-content {
      text-align: left;
      max-width: 80rem;
    }

    #faq-1194 .cs-title {
      /* 20 characters wide including spaces */
      max-width: 120ch;
      margin: 0 0 2rem 0;
    }

    #faq-1194 :global(.markdown-text) {
      width: 100%;
      background-color: #ffffff;
      border: 1px solid #e5e7eb;
      border-radius: 0.75rem;
      box-shadow: 0 1px 3px 0 rgba(0, 0, 0, 0.06);
      padding: clamp(1.5rem, 4vw, 2.5rem);
    }
    #faq-1194 :global(.markdown-text h3) {
      color: var(--primary);
      font-weight: 700;
      padding-bottom: 0.5rem;
      margin-top: 2.25rem;
      border-bottom: 2px solid #e5e7eb;
    }
    #faq-1194 :global(.markdown-text h3:first-child) {
      margin-top: 0;
    }
    #faq-1194 :global(.markdown-text strong) {
      color: var(--headerColor, #1a1a1a);
    }
    #faq-1194 :global(.markdown-text ul li::marker),
    #faq-1194 :global(.markdown-text ol li::marker) {
      color: var(--primary);
    }

  }
  /* Desktop - 1024px */
  @media only screen and (min-width: 64rem) {
    #faq-1194 .cs-container {
      max-width: 80rem;
      flex-direction: row;
      justify-content: space-between;
      align-items: stretch;
    }
    #faq-1194 .cs-content {
      width: 100%;
    }

  }
</style>
